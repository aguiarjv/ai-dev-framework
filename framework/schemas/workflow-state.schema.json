{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI workflow state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "phase", "status", "active_subtask", "review_cycles", "blockers", "history"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1"] },
    "task_id": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "enum": ["intake", "exploration", "specification", "approval", "planning", "implementation", "verification", "review", "remediation", "done", "blocked"]
    },
    "status": { "type": "string", "enum": ["pending", "running", "blocked", "complete"] },
    "active_subtask": { "type": ["string", "null"] },
    "review_cycles": { "type": "integer", "minimum": 0, "maximum": 5 },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "status", "at", "actor", "evidence"],
        "properties": {
          "phase": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
