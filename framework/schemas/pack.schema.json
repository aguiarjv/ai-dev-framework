{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Dev Framework Pack",
  "type": "object",
  "required": ["name", "version", "guide", "adapters", "agents", "skills"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "guide": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "guides": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "adapters": {
      "type": "array",
      "items": { "type": "string", "enum": ["codex", "claude"] }
    },
    "templates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "harnesses": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "agents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    }
  },
  "additionalProperties": false
}
