{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI workflow agent result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "task_id",
    "subtask_id",
    "agent",
    "status",
    "files_changed",
    "acceptance_criteria",
    "verification",
    "blockers",
    "residual_risks",
    "next_action"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1"] },
    "result_id": { "type": "string", "pattern": "^R-[0-9]+$" },
    "task_id": { "type": "string", "minLength": 1 },
    "subtask_id": { "type": "string", "pattern": "^T-[0-9]+$" },
    "agent": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["complete", "partial", "blocked"] },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "status": { "type": "string", "enum": ["met", "partial", "not_met", "not_checked"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "blocked", "not_run"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "residual_risks": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string", "minLength": 1 }
  }
}
