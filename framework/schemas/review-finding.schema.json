{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI workflow review finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "severity",
    "confidence",
    "status",
    "location",
    "impact",
    "evidence",
    "required_fix",
    "verification"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1"] },
    "finding_id": { "type": "string", "pattern": "^F-[0-9]+$" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "confidence": { "type": "string", "enum": ["confirmed", "likely", "uncertain"] },
    "status": { "type": "string", "enum": ["open", "fixed", "rejected", "waived"] },
    "location": { "type": "string", "minLength": 1 },
    "criterion_ids": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
    "impact": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_fix": { "type": "string", "minLength": 1 },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
