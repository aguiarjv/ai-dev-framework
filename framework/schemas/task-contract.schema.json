{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI workflow task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "status",
    "task_type",
    "objective",
    "scope",
    "acceptance_criteria",
    "subtasks",
    "review_policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1"] },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "in_progress", "review", "remediation", "done", "blocked"]
    },
    "task_type": {
      "type": "string",
      "enum": ["frontend", "backend", "full-stack", "docs", "test", "infra"]
    },
    "objective": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "task_type",
          "owner",
          "status",
          "depends_on",
          "paths",
          "acceptance_criteria",
          "verification",
          "parallelizable",
          "done_when"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "task_type": {
            "type": "string",
            "enum": ["frontend", "backend", "full-stack", "docs", "test", "infra"]
          },
          "owner": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pending", "ready", "in_progress", "review", "done", "blocked"] },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^T-[0-9]+$" } },
          "paths": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]+$" } },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "parallelizable": { "type": "boolean" },
          "done_when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "base_revision"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "base_revision": { "type": ["string", "null"] }
      }
    },
    "context_refs": { "type": "array", "items": { "type": "string" } },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "areas"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "areas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "max_remediation_cycles"],
      "properties": {
        "required": { "type": "boolean" },
        "max_remediation_cycles": { "type": "integer", "minimum": 0, "maximum": 5 },
        "slices": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
